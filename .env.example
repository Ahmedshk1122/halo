# Copy to .env and fill in. .env is gitignored; the key never reaches the browser.
ANTHROPIC_API_KEY=
# (HALO_ANTHROPIC_API_KEY is also accepted, for environments where ANTHROPIC_API_KEY is taken.)

# Director: runs on every speech segment, so it defaults to the fast model.
HALO_DIRECTOR_MODEL=claude-haiku-5-5
# low | medium | high. Lower is faster.
HALO_DIRECTOR_EFFORT=low

# Planner: one pass over your talk notes before you present.
HALO_PLANNER_MODEL=claude-opus-5-5
HALO_PLANNER_EFFORT=medium

# Local API server (Vite proxies /api to it).
HALO_SERVER_PORT=8787

# Easiest way to add a key: npm run key claude | kimi | qwen | gemini
# (it hides the key as you paste, saves it here and sets HALO_PROVIDER).
# Pick a provider with HALO_PROVIDER (anthropic, kimi, qwen or gemini). Unset: whichever key is present.

# --- Optional: Kimi (Moonshot AI) instead of Claude ---
# HALO_PROVIDER=kimi
# KIMI_API_KEY=
# Run "npm run dev" and the server prints the models your key can use.
# KIMI_DIRECTOR_MODEL=kimi-k3
# KIMI_PLANNER_MODEL=kimi-k3
# off | on | default. Off answers fastest.
# KIMI_THINKING=off
# Empty: tries https://api.moonshot.ai/v1, then https://api.moonshot.cn/v1.
# KIMI_BASE_URL=

# --- Optional: Qwen (Alibaba Cloud Model Studio) instead of Claude ---
# HALO_PROVIDER=qwen
# QWEN_API_KEY=
# QWEN_DIRECTOR_MODEL=qwen-plus
# QWEN_PLANNER_MODEL=qwen-plus
# QWEN_THINKING=off
# Empty: tries the international endpoint, then the China one.
# QWEN_BASE_URL=

# Kimi, Qwen and Claude decide as soon as speech arrives. Add a gap between requests if you want one.
# HALO_MIN_INTERVAL_MS=0
# How long one director decision may take (Kimi and Qwen default 20000, others 9000).
# HALO_DIRECTOR_TIMEOUT_MS=

# --- Optional: Google Gemini instead of Claude (Google offers a free tier) ---
# HALO_PROVIDER=gemini
# GEMINI_API_KEY=
# The "-latest" aliases follow Google's newest Flash-Lite model.
# GEMINI_DIRECTOR_MODEL=gemini-flash-lite-latest
# GEMINI_PLANNER_MODEL=gemini-flash-lite-latest
# Free-tier keys allow only a few requests a minute, so Halo spaces director calls this far apart.
# GEMINI_MIN_INTERVAL_MS=6000
# minimal | low | medium | high, for models that support it (empty: model default).
# GEMINI_THINKING_LEVEL=
